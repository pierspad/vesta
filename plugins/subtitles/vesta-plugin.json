{
  "id": "subtitles-veplugin",
  "name": "Subtitles",
  "version": "1.0.0",
  "apiVersion": 1,
  "description": "Subtitle search via OpenSubtitles, local video track extraction, and flashcards integration for Vesta.",
  "author": "Browzomje",
  "icon": "icon.png",
  "entry": {
    "command": ["python3", "main.py"],
    "os": {
      "windows": ["python.exe", "main.py"]
    }
  },
  "permissions": [
    "network",
    "filesystem:downloads"
  ],
  "tab": {
    "settingsScreen": "settings",
    "title": "Subtitles",
    "icon": "icon.png"
  },
  "settings": [
    {
      "id": "opensubtitles_api_key",
      "label": "OpenSubtitles API Key",
      "type": "password",
      "description": "Consumer API key from opensubtitles.com",
      "defaultValue": "",
      "hint": "Free API key from opensubtitles.com",
      "link": {
        "label": "Where do I find this key?",
        "url": "https://www.opensubtitles.com/en/consumers"
      }
    },
    {
      "id": "preferred_languages",
      "label": "Preferred Languages",
      "type": "text",
      "description": "Preferred subtitle languages",
      "defaultValue": "en",
      "hint": "Default search languages (e.g. en, ja)"
    },
    {
      "id": "default_download_dir",
      "label": "Default Download Directory",
      "type": "text",
      "description": "Destination folder for downloaded subtitles",
      "defaultValue": ""
    },
    {
      "id": "opensubtitles_username",
      "label": "OpenSubtitles Username",
      "type": "text",
      "description": "Optional username for increased download quota",
      "defaultValue": "",
      "hint": "Optional account username",
      "expertOnly": true
    },
    {
      "id": "opensubtitles_password",
      "label": "OpenSubtitles Password",
      "type": "password",
      "description": "Optional password for OpenSubtitles user login",
      "defaultValue": "",
      "hint": "Optional account password",
      "expertOnly": true
    },
    {
      "id": "dry_run_default",
      "label": "Dry-run mode by default",
      "type": "checkbox",
      "description": "Safety mode to simulate commands and downloads without file modifications",
      "defaultValue": false,
      "expertOnly": true
    },
    {
      "id": "ffmpeg_path",
      "label": "Custom FFmpeg Path",
      "type": "text",
      "description": "Custom executable path for ffmpeg",
      "defaultValue": "",
      "expertOnly": true
    },
    {
      "id": "ffprobe_path",
      "label": "Custom ffprobe Path",
      "type": "text",
      "description": "Custom executable path for ffprobe",
      "defaultValue": "",
      "expertOnly": true
    }
  ]
}
