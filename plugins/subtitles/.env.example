# OpenSubtitles.com API Credentials
# Get your free consumer API key at: https://www.opensubtitles.com/en/consumers
OPENSUBTITLES_API_KEY=your_api_key_here

# Optional user credentials for higher download quotas
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Preferred subtitle languages (comma-separated ISO-639-1 / ISO-639-2 codes, e.g. en,ja,es)
OPENSUBTITLES_LANGUAGES=en

# Default directory for downloaded subtitle files (optional; defaults to Vesta data folder)
OPENSUBTITLES_DOWNLOAD_DIR=

# Subprocess & extraction dry-run simulation mode (true/false)
OPENSUBTITLES_DRY_RUN=false
