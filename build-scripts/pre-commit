#!/usr/bin/env bash
# Validate the actual staged content; unstaged fixes must not hide bad commits.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
SNAPSHOT="$(mktemp -d "${TMPDIR:-/tmp}/vesta-index.XXXXXX")"
trap 'rm -rf "$SNAPSHOT"' EXIT
git ls-files -z -- Cargo.toml core lib cli apps scorecard docs/SCORECARD.md | git checkout-index --stdin -z --prefix="$SNAPSHOT/"
echo "Checking staged scorecard metrics and database..."
python3 "$ROOT/build-scripts/generate_scorecard.py" --repo-root "$SNAPSHOT" --check
python3 "$ROOT/build-scripts/scorecard_db.py" check --repo-root "$SNAPSHOT"
# Compiler dependency comes from the installed runtime; source still comes only
# from the index snapshot, so an unstaged fix cannot conceal a bad commit.
ln -s "$ROOT/apps/vesta-gui/node_modules" "$SNAPSHOT/apps/vesta-gui/node_modules"
echo "Checking staged localization..."
bash "$ROOT/build-scripts/check-i18n.sh" "$SNAPSHOT"
