# Rust
target/
**/*.rs.bk
*.pdb

# Binari compilati copiati fuori da target/ (build_all.sh li rigenera)
/bin/
cli/*/vesta-extract
cli/*/vesta-translate
cli/*/vesta-flashcards
cli/*/vesta-autosync
cli/*/vesta-transcribe

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Frontend
node_modules/
dist/

# Note locali di sviluppo (mai da pushare)
.notes/

# OS
.DS_Store
Thumbs.db


# Configuration files with sensitive data
.env
*.key
config.toml 
!.cargo/config.toml

# subs2srs is vendored as source under
# benchmarking_against_subs2srs/subs2srs_source_code/ (GPLv3, kept whole
# with its copyright notices + gpl.txt) for full benchmark reproducibility.

# File video/audio grandi (Test_Subs media inclusi: si scaricano/generano
# con gli script in Test_Subs/, mai committati)
*.mkv
*.mp4
*.avi
*.mov
*.wav
*.mp3
*.flac
.directory
!/apps/.directory
!/build-scripts/.directory
!/cli/.directory
!/core/.directory
!/docs/.directory
!/lib/.directory

# Generated/test artifacts
__pycache__/
*.pyc
build-scripts/vesta-*.*.*.deb
apps/*/src-tauri/binaries/
# LICENSE/.SRCINFO sono scaricati/generati da makepkg: se restano committati,
# updpkgsums li trova già presenti e salta il download da GitHub, congelando
# un hash vecchio invece di quello reale (causa del validity check FAILED).
build-scripts/LICENSE
build-scripts/LICENSE-*
build-scripts/.SRCINFO

# Test_Subs: solo Detour (1945, pubblico dominio) è committato.
# Ogni altro sottotitolo resta in locale per evitare problemi di licensing.
Test_Subs/**/*.srt
!Test_Subs/FILM/Detour-en.srt
!Test_Subs/FILM/Detour-it.srt
!Test_Subs/SERIE_TV/Detour-en_parte*.srt
!Test_Subs/SERIE_TV/Detour-it_parte*.srt
!Test_Subs/fixtures/*.srt
apps/vesta-gui/reports/
apps/vesta-gui/scripts/translation_chunks/
!Test_Subs/fixtures/detour/*.srt
!Test_Subs/fixtures/detour/detour_clip_90s.mp4

# Superpowers design docs/plans: locali, non tracciati.
docs/superpowers/

# Local benchmark console captures
/benchmark-subs2srs*.log

# Vite dependency cache
.vite/
