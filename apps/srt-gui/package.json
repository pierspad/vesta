{
  "name": "vesta",
  "private": true,
  "version": "0.29.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri:prepare": "tauri icon src-tauri/icons/icon.svg -o src-tauri/icons",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "i18n:audit": "python3 scripts/check_missing_translations.py",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "npm run check:patterns && vitest run",
    "test:watch": "vitest",
    "check:patterns": "node --test scripts/check-code-patterns.test.mjs && node scripts/check-code-patterns.mjs",
    "tauri": "tauri",
    "test:dev-css": "node scripts/check-dev-css.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tsconfig/svelte": "^5.0.8",
    "happy-dom": "^21.0.1",
    "jsdom": "^30.1.3",
    "svelte": "^5.55.7",
    "svelte-check": "^4.4.8",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.1"
  }
}
