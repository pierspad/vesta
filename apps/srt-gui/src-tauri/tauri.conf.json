{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vesta",
  "version": "0.32.0-dev.1",
  "identifier": "com.vesta.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run tauri:prepare && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "vesta",
        "width": 1720,
        "height": 1050,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 340,
        "minHeight": 500,
        "maxWidth": 10000,
        "maxHeight": 10000,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http://127.0.0.1:*; media-src 'self' data: blob: http://127.0.0.1:* stream: http://stream.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://localhost:*; object-src 'none'; base-uri 'self'",
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "category": "Education",
    "shortDescription": "Generate Anki flashcards, translations, and synced subtitles from video and audio",
    "resources": { "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md" },
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libvulkan1"]
      },
      "rpm": {
        "depends": ["vulkan-loader"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
